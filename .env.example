# ---- Telegram (Pflicht) ----
# BotFather -> /newbot -> Token.
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID: dem Bot eine Nachricht schicken, dann
# https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen -> message.chat.id
# Nur dieser Chat darf Befehle geben.
TELEGRAM_CHAT_ID=

# ---- Defaults für /add ohne SL/TP (Prozent zum Einstiegskurs) ----
DEFAULT_SL_PCT=20
DEFAULT_TP_PCT=30

# ---- Abfrage-Intervalle in Sekunden ----
# während der Handelszeit / außerhalb
POLL_SECONDS=30
POLL_SECONDS_CLOSED=300

# ---- Handelszeit (Emittenten stellen meist 08:00-22:00 Kurse) ----
MARKET_TZ=Europe/Berlin
MARKET_OPEN=08:00
MARKET_CLOSE=22:00

# ---- Alarme ----
# Warnung, wenn der Basiswert näher als X % an der KO-Schwelle ist (0 = aus)
KO_WARN_PCT=3
# Erinnerung nach SL/TP-Alarm alle X Minuten bis /remove (0 = aus)
REMINDER_MINUTES=30
# Warnung, wenn während der Handelszeit X Minuten kein neuer Kurs kommt (0 = aus)
STALE_MINUTES=15
# Tägliche "Bot läuft"-Nachricht an Werktagen (leer = aus)
HEARTBEAT_TIME=08:00

# ---- Sonstiges ----
DB_PATH=state/positions.db
LOG_LEVEL=INFO
